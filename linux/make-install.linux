#!/usr/bin/env bash

set -e

LGI=../../../lgi/trunk
if [ ! -d $LGI ] 
then
    echo "Error: lgi doesn't exist." 
    exit -1
fi

LGI_DEPS=../../../lgi/deps/build-x64-release/lib
if [ ! -d $LGI_DEPS ] 
then
    echo "Error: codelib doesn't exist." 
    exit -1
fi

SRC=../src
if [ ! -d $SRC ] 
then
    echo "Error: src doesn't exist." 
    exit -1
fi

RES=../resources
if [ ! -d $RES ] 
then
    echo "Error: resources doesn't exist." 
    exit -1
fi

LIBS=../../libs/build-x64-release/lib
if [ ! -d $LIBS ] 
then
    echo "Error: libs doesn't exist." 
    exit -1
fi

DEPLOY=./appimagetool-x86_64.AppImage
if [ ! -f $DEPLOY ] 
then
    echo "Error: appimagetool doesn't exist." 
    echo "Download: https://github.com/AppImage/appimagetool/releases/tag/continuous"
    exit -1
fi

VERSION=$(python3 ../utils/getversion.py)
APPIMG=$VERSION.AppImage
APPDIR=$VERSION.AppDir
BINDIR=$APPDIR/usr/bin
LIBDIR=$APPDIR/usr/lib
RESDIR=$APPDIR/usr/share/applications
BUILD=Release
TAG=

# scribe libs:
ASPELL_SO="$LIBS/libaspell-dist-0.60$TAG.so"
BZIP_SO="$LIBS/libbzip2.so"
CHARDET_SO="$LIBS/libchardet.so"
BTREE_SO="$LIBS/libbtree.so"

# lgi libs:
LGI_SO="$LGI/$BUILD/liblgi-gtk3$TAG.so"
LIBPNG="$LGI_DEPS/libpng*.so*"
ZLIB="$LGI_DEPS/libz*.so*"
LIBJPEG="$LGI_DEPS/libjpeg*.so*"
LIBNTLM="$LGI_DEPS/libntlm.so"
ICONV="$LGI_DEPS/libiconv.so"

rm -rf $APPDIR

echo "Building AppDir..."
mkdir -p $BINDIR
mkdir -p $LIBDIR
mkdir -p $RESDIR

echo "Creating DOM documentation..."
python3 ../src/Py/DomScan.py > $RESDIR/Dom.txt

echo "Copying binaries..."
cp ../scribe $BINDIR

cp $ASPELL_SO  $LIBDIR
cp $CHARDET_SO $LIBDIR
cp $BZIP_SO    $LIBDIR
cp $BTREE_SO   $LIBDIR

cp $LGI/src/linux/CrashHandler/crash-handler $BINDIR
cp $LGI_SO     $LIBDIR
cp -av --preserve=links $LIBPNG     $LIBDIR
cp -av --preserve=links $ZLIB       $LIBDIR
cp -av --preserve=links $LIBJPEG    $LIBDIR
cp $LIBNTLM    $LIBDIR
cp $ICONV      $LIBDIR

chmod 755 $BINDIR/*
chmod 755 $LIBDIR/*

echo "Copy resources..."
chmod 700 $RES/AppRun
cp $RES/AppRun $APPDIR
cp $RES/Linux/scribe.desktop $APPDIR
cp $RES/About64px.png $APPDIR
cp $RES/Scribe.lr8 $RESDIR/Scribe.lr8
cp $RES/Flags.png $RESDIR
cp $RES/Icons-16.png $RESDIR
cp $RES/xgate-icons-32.png $RESDIR
cp $RES/About.html $RESDIR
cp $RES/About64px.png $RESDIR
cp $RES/Title.html $RESDIR
cp $RES/Title.png $RESDIR
cp $RES/NoFace*.png $RESDIR
cp $RES/EmojiMap.png $RESDIR
cp $RES/Preview*.html $RESDIR
cp $RES/tray_*.png $RESDIR

mkdir -p $RESDIR/help/scripting
cp ../help/*.html $RESDIR/help
cp ../help/*.css $RESDIR/help
cp $LGI/docs/scripting/*.html $RESDIR/help/scripting
cp $LGI/docs/scripting/*.css $RESDIR/help/scripting

mkdir -p $RESDIR/scripts
cp ../scripts/*.script $RESDIR/scripts
cp ../scripts/ScribeScripts.h $RESDIR/scripts
cp $RES/resdefs.h $RESDIR/scripts

mkdir -p $RESDIR/Aspell/data
cp $RES/aspell-languages.csv $RESDIR/Aspell
cp ../../libs/aspell-0.60.6.1/data/*.cmap $RESDIR/Aspell/data
cp ../../libs/aspell-0.60.6.1/data/*.cset $RESDIR/Aspell/data
cp ../../libs/aspell-0.60.6.1/data/*.kbd $RESDIR/Aspell/data

echo "Building AppImage..."
$DEPLOY $APPDIR


