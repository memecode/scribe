-include $(Objects:.o=.d)

# Clean just this target
clean :
	rm -rf $(BuildDir) $(Target)
	@echo Cleaned $(BuildDir) $(Target)

# Clean all targets
cleanall :
	rm -rf $(BuildDir) $(Target)
	@echo Cleaned $(BuildDir) $(Target)
	+make -C "../../libs/aspell-0.60.6.1/linux" -f "Makefile.linux" clean
	+make -C "../../libs/bzip2-1.0.6/linux" -f "Makefile.linux" clean
	+make -C "../../../lgi/trunk" -f "Makefile.linux" clean

