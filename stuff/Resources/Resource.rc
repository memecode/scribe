/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
MAIL                    ICON    DISCARDABLE     "mail.ico"
BLANK                   ICON    DISCARDABLE     "blank.ico"
SMALL                   ICON    DISCARDABLE     "small.ico"
APP                     ICON    DISCARDABLE     "app.ico"

/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

MENU MENU DISCARDABLE 
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&Open Folders",               IDM_OPEN_FOLDERS
        MENUITEM "Create &Folders",             IDM_CREATE_FOLDERS
        MENUITEM "Com&pact Folders",            IDM_COMPACT_FOLDERS
        MENUITEM SEPARATOR
        MENUITEM "Op&tions",                    IDM_OPTIONS
        MENUITEM SEPARATOR
        MENUITEM "&Print",                      IDM_PRINT
        MENUITEM "Print &Setup",                IDM_PRINTSETUP
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                       IDM_EXIT
    END
    POPUP "&Mail"
    BEGIN
        MENUITEM "New &Message",                IDM_NEW
        MENUITEM SEPARATOR
        MENUITEM "&Reply",                      IDM_REPLY
        MENUITEM "Reply to &All",               IDM_REPLY_ALL
        MENUITEM "&Forward",                    IDM_FORWARD
        MENUITEM SEPARATOR
        MENUITEM "&Send Mail",                  IDM_SEND_MAIL
        MENUITEM "R&eceive Mail",               IDM_RECEIVE_MAIL
    END
    POPUP "&Contacts"
    BEGIN
        MENUITEM "New &Contact",                IDM_NEW_CONTACT
        MENUITEM SEPARATOR
        POPUP "Import"
        BEGIN
            MENUITEM "&Scribe Contacts",            IDM_IMPORT_CONTACTS
            MENUITEM "&Outlook Contacts",           IDM_IMPORT_OUTLOOK_CONTACTS

        END
        MENUITEM "&Export Contacts",            IDM_EXPORT_CONTACTS
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&Help",                       IDM_HELP
        MENUITEM SEPARATOR
        MENUITEM "&About",                      IDM_ABOUT
    END
END

