; Scribe install/uninstall support
!include LogicLib.nsh
; !include WinVer.nsh

!system "cmd /c echo NSIS working directory: %CD%" = 0
!system "python utils\Store\check-build.py" = 0

!system "mkdir scribe-setup"
!system "del /Q scribe-setup\*.*"

!system "copy $<SHELL_PATH:$<TARGET_FILE:scribe>> scribe-setup" = 0
!system "copy $<SHELL_PATH:$<TARGET_FILE:ScribeMapi>> scribe-setup" = 0

!system "copy $<SHELL_PATH:$<TARGET_FILE:aspell>> scribe-setup" = 0

!system "copy jpeg62.dll scribe-setup" = 0
!system "copy libpng16.dll scribe-setup" = 0
!system "copy libz.dll scribe-setup" = 0
!system "copy $<SHELL_PATH:$<TARGET_FILE:chardet>> scribe-setup" = 0
!system "copy $<SHELL_PATH:$<TARGET_FILE:btree>> scribe-setup" = 0
!system "copy $<SHELL_PATH:$<TARGET_FILE:bzip2>> scribe-setup" = 0

!system "copy $<SHELL_PATH:$<TARGET_FILE:lgi>> scribe-setup" = 0
!system "copy libiconv.dll scribe-setup" = 0
!system "copy libntlm.dll scribe-setup" = 0
!system "copy lunasvg.dll scribe-setup" = 0
!system "copy plutovg.dll scribe-setup" = 0
!system "copy $<SHELL_PATH:$<TARGET_FILE:Updater>> scribe-setup" = 0

;system '"c:\Program Files\Upx\upx.exe" -9 .\scribe-setup\*.exe'
;system '"c:\Program Files\Upx\upx.exe" -9 .\scribe-setup\*.dll'

; Generate the DOM documentation
!system "python ..\src\Py\DomScan.py ..\src ..\..\..\lgi\trunk > scribe-setup\Dom.txt" = 0

!system "python ..\utils\Store\store.py $<SHELL_PATH:$<TARGET_FILE_DIR:scribe>>\*.pdb Scribe ${__DATE__} ${__TIME__}" = 0
!system "python ..\utils\Store\store.py $<SHELL_PATH:$<TARGET_FILE_DIR:ScribeMapi>>\*.pdb Mapi ${__DATE__} ${__TIME__}" = 0
!system "python ..\utils\Store\store.py $<SHELL_PATH:$<TARGET_FILE_DIR:lgi>>\*.pdb Lgi ${__DATE__} ${__TIME__}" = 0

;--------------------------------
SetCompressor lzma

; The name of the installer
Name "Memecode Scribe"

; The file to write
!define OUTFILE "scribe-win64-v###.exe"
OutFile ${OUTFILE}

; The default installation directory
InstallDir $PROGRAMFILES64\Memecode\Scribe
InstallDirRegKey HKCU "Software\Memecode\Scribe" Install
SetRegView 64

; Only remove an extension mapping when it still points at a Scribe ProgID.
!macro CleanAssoc base prog ext
	ReadRegStr $0 ${base} "Software\Classes\${ext}" ""
	${If} $0 == "${prog}"
		DeleteRegKey ${base} "Software\Classes\${ext}"
	${EndIf}
!macroend

!macro CleanProg base prog
	DeleteRegValue ${base} "Software\Classes\${prog}" ""
	DeleteRegValue ${base} "Software\Classes\${prog}" "FriendlyTypeName"
	DeleteRegValue ${base} "Software\Classes\${prog}" "InfoTip"
	DeleteRegValue ${base} "Software\Classes\${prog}" "URL Protocol"

	DeleteRegValue ${base} "Software\Classes\${prog}\shell\open\command" ""
	DeleteRegKey ${base} "Software\Classes\${prog}\shell\open\command"
	DeleteRegKey ${base} "Software\Classes\${prog}\shell\open"
	DeleteRegKey ${base} "Software\Classes\${prog}\shell"

	DeleteRegValue ${base} "Software\Classes\${prog}\DefaultIcon" ""
	DeleteRegKey ${base} "Software\Classes\${prog}\DefaultIcon"

	DeleteRegKey ${base} "Software\Classes\${prog}"
!macroend

!macro CleanClient base
	DeleteRegValue ${base} "Software\Clients\Mail\Scribe" ""
	DeleteRegValue ${base} "Software\Clients\Mail\Scribe" "DllPath"

	DeleteRegValue ${base} "Software\Clients\Mail\Scribe\shell\open\command" ""
	DeleteRegKey ${base} "Software\Clients\Mail\Scribe\shell\open\command"
	DeleteRegKey ${base} "Software\Clients\Mail\Scribe\shell\open"
	DeleteRegKey ${base} "Software\Clients\Mail\Scribe\shell"

	DeleteRegValue ${base} "Software\Clients\Mail\Scribe\DefaultIcon" ""
	DeleteRegKey ${base} "Software\Clients\Mail\Scribe\DefaultIcon"

	DeleteRegValue ${base} "Software\Clients\Mail\Scribe\Capabilities" "ApplicationDescription"
	DeleteRegValue ${base} "Software\Clients\Mail\Scribe\Capabilities" "ApplicationName"
	DeleteRegValue ${base} "Software\Clients\Mail\Scribe\Capabilities" "ApplicationIcon"

	DeleteRegValue ${base} "Software\Clients\Mail\Scribe\Capabilities\FileAssociations" ".eml"
	DeleteRegValue ${base} "Software\Clients\Mail\Scribe\Capabilities\FileAssociations" ".msg"
	DeleteRegValue ${base} "Software\Clients\Mail\Scribe\Capabilities\FileAssociations" ".mbox"
	DeleteRegValue ${base} "Software\Clients\Mail\Scribe\Capabilities\FileAssociations" ".mbx"
	DeleteRegValue ${base} "Software\Clients\Mail\Scribe\Capabilities\FileAssociations" ".ics"
	DeleteRegValue ${base} "Software\Clients\Mail\Scribe\Capabilities\FileAssociations" ".vcs"
	DeleteRegValue ${base} "Software\Clients\Mail\Scribe\Capabilities\FileAssociations" ".vcf"
	DeleteRegValue ${base} "Software\Clients\Mail\Scribe\Capabilities\FileAssociations" ".mail3"
	DeleteRegKey ${base} "Software\Clients\Mail\Scribe\Capabilities\FileAssociations"

	DeleteRegValue ${base} "Software\Clients\Mail\Scribe\Capabilities\UrlAssociations" "mailto"
	DeleteRegKey ${base} "Software\Clients\Mail\Scribe\Capabilities\UrlAssociations"

	DeleteRegKey ${base} "Software\Clients\Mail\Scribe\Capabilities"
	DeleteRegKey ${base} "Software\Clients\Mail\Scribe"
!macroend

!macro CleanMailDefault base
	ReadRegStr $0 ${base} "Software\Clients\Mail" ""
	${If} $0 == "Scribe"
		DeleteRegValue ${base} "Software\Clients\Mail" ""
	${EndIf}
!macroend

;--------------------------------

; Pages

Page directory
Page components
Page instfiles

; The stuff to install
Section ""

	; Set output path to the installation directory.
	SetOutPath $INSTDIR

	; Clean out old files
	Delete $INSTDIR\libjpeg12x64.dll
	Delete $INSTDIR\libntlm12x64nop.dll
	Delete $INSTDIR\libpng12x64.dll
	Delete $INSTDIR\zlib12x64.dll
	Delete $INSTDIR\Lgi*.dll

	; Program files
	File .\scribe-setup\*.exe
	File .\scribe-setup\*.dll

	; Resources
	CreateDirectory $INSTDIR\Resources
	SetOutPath $INSTDIR\Resources
	File Resources\Scribe.lr8
	File Resources\Flags.png
	File Resources\Icons-16.png
	File Resources\xgate-icons-32.png
	File Resources\About64px.png
	File Resources\About.html
	File Resources\Title.html
	File Resources\Title.png
	File Resources\NoFace*.png
	File Resources\EmojiMap.png
	File Resources\Preview*.html
	File Resources\sign_in_with_google.png

	CreateDirectory $INSTDIR\Resources\Themes
	SetOutPath $INSTDIR\Resources\Themes
	File Resources\Themes\readme.txt

	CreateDirectory $INSTDIR\Resources\Themes\Dark
	SetOutPath $INSTDIR\Resources\Themes\Dark
	File Resources\Themes\Dark\*
 
	; Aspell support
	CreateDirectory $INSTDIR\Aspell
	SetOutPath $INSTDIR\Aspell
	File Resources\aspell-languages.csv
	CreateDirectory $INSTDIR\Aspell\data
	SetOutPath $INSTDIR\Aspell\data
	File libs\aspell-0.60.6.1\data\*.cmap
	File libs\aspell-0.60.6.1\data\*.cset
	File libs\aspell-0.60.6.1\data\*.kbd
 
	; Scripts
	CreateDirectory $INSTDIR\Scripts
	SetOutPath $INSTDIR\Scripts
	File .\scribe-setup\Dom.txt
	File Resources\resdefs.h

	File Scripts\ScribeScripts.h
	File "Scripts\Add Senders To Contacts.script"
	File "Scripts\Delete Attachments.script"
	File "Scripts\Delete Duplicate Messages.script"
	File "Scripts\Mail Filters Menu.script"

	; Help files
	CreateDirectory $INSTDIR\Help
	SetOutPath $INSTDIR\Help
	File Help\*.html
	File Help\*.css
	CreateDirectory $INSTDIR\Help\scripting
	SetOutPath $INSTDIR\Help\scripting
	File Help\scripting\*.html
	File Help\scripting\*.css
  
	; Do CRT check
	ExecWait '"$INSTDIR\Scribe.exe" -crtcheck' $0
	${If} $0 != 0
		inetc::get /caption "Visual Studio 2019 Redistributable" /popup "" "https://memecode.com/scribe/data/vcredist_vs2019x64.exe" "$INSTDIR\vcredist_vs2019x64.exe" /end
		Pop $0 # return value = exit code, "OK" means OK
		DetailPrint "Download: $0"
		${If} $0 == "OK"
			ExecWait "$INSTDIR\vcredist_vs2019x64.exe"
			Delete "$INSTDIR\vcredist_vs2019x64.exe"
		${EndIf}
	${EndIf}

SectionEnd ; end the section

Section "Desktop Install (Non-portable)"

	; Install location into registry
	WriteRegStr HKCU "Software\Memecode\Scribe" Install $INSTDIR

	; Uninstaller. The key is product based rather than version based, so an upgrade updates
	; the same entry instead of leaving a stale one behind.
	WriteUninstaller $INSTDIR\uninstall.exe

	GetDllVersionLocal ".\scribe-setup\Scribe.exe" $R0 $R1
	IntOp $R2 $R0 / 0x00010000
	IntOp $R3 $R0 & 0x0000FFFF
	IntOp $R4 $R1 / 0x00010000
	IntOp $R5 $R1 & 0x0000FFFF

	!define UNINSTKEY "Software\Microsoft\Windows\CurrentVersion\Uninstall\Memecode_Scribe"
	WriteRegStr HKLM "${UNINSTKEY}" "DisplayVersion" "$R2.$R3.$R4.$R5"
	WriteRegStr HKLM "${UNINSTKEY}" "DisplayName" "Memecode Scribe"
	WriteRegStr HKLM "${UNINSTKEY}" "Publisher" "Memecode"
	WriteRegStr HKLM "${UNINSTKEY}" "InstallLocation" "$INSTDIR"
	WriteRegStr HKLM "${UNINSTKEY}" "InstallSource" "$EXEDIR"
	WriteRegStr HKLM "${UNINSTKEY}" "DisplayIcon" "$INSTDIR\Scribe.exe"
	WriteRegStr HKLM "${UNINSTKEY}" "UninstallString" "$\"$INSTDIR\uninstall.exe$\""
	WriteRegStr HKLM "${UNINSTKEY}" "URLInfoAbout" "https://www.memecode.com/"
	WriteRegStr HKLM "${UNINSTKEY}" "URLUpdateInfo" "https://www.memecode.com/scribe"

	; Start menu items
	CreateDirectory "$SMPROGRAMS\Memecode Scribe"
	CreateShortCut "$SMPROGRAMS\Memecode Scribe\Scribe.lnk" "$INSTDIR\Scribe.exe" "" "$INSTDIR\Scribe.exe" 0
	CreateShortCut "$SMPROGRAMS\Memecode Scribe\Help.lnk" "$INSTDIR\Help\index.html"
	CreateShortCut "$SMPROGRAMS\Memecode Scribe\Uninstall.lnk" "$INSTDIR\uninstall.exe" "" "$INSTDIR\uninstall.exe" 0

SectionEnd

Section "Run Scribe"

	ExecShell "open" "$INSTDIR\Scribe.exe"
	SetAutoClose true

SectionEnd

UninstPage components
UninstPage instfiles

Section "un.Program and Start Menu Items"

	Delete $INSTDIR\Uninst.exe ; delete self

	RMDir /r $INSTDIR\Help
	RMDir /r $INSTDIR\Resources
	RMDir /r $INSTDIR\Scripts
	RMDir /r $INSTDIR\ImapCache
	RMDir /r $INSTDIR\Aspell
	RMDir /r $INSTDIR\Resources

	Delete $INSTDIR\*.exe
	Delete $INSTDIR\*.dll
	Delete $INSTDIR\*.gif
	Delete $INSTDIR\*.lr8
	Delete $INSTDIR\*.html
	Delete $INSTDIR\*.txt
	Delete $INSTDIR\*.asm
	
	RMDir $INSTDIR ; recursive is dangerous if they install to "c:\program files\" for instance.

	RMDir /r "$SMPROGRAMS\Memecode Scribe"

	SetRegView 64

	; Scribe registers ProgIDs per-user first, and machine-wide when elevated. Extension
	; mappings are only cleared when they still point at Scribe.
	!insertmacro CleanAssoc HKCU Memecode.Scribe.Email .eml
	!insertmacro CleanAssoc HKCU Memecode.Scribe.Email .msg
	!insertmacro CleanAssoc HKCU Memecode.Scribe.Folder .mbox
	!insertmacro CleanAssoc HKCU Memecode.Scribe.Folder .mbx
	!insertmacro CleanAssoc HKCU Memecode.Scribe.Calendar .ics
	!insertmacro CleanAssoc HKCU Memecode.Scribe.Calendar .vcs
	!insertmacro CleanAssoc HKCU Memecode.Scribe.Contact .vcf
	!insertmacro CleanAssoc HKCU Memecode.Scribe.MailStore .mail3
	!insertmacro CleanAssoc HKCU Memecode.Scribe.Mailto mailto

	!insertmacro CleanAssoc HKLM Memecode.Scribe.Email .eml
	!insertmacro CleanAssoc HKLM Memecode.Scribe.Email .msg
	!insertmacro CleanAssoc HKLM Memecode.Scribe.Folder .mbox
	!insertmacro CleanAssoc HKLM Memecode.Scribe.Folder .mbx
	!insertmacro CleanAssoc HKLM Memecode.Scribe.Calendar .ics
	!insertmacro CleanAssoc HKLM Memecode.Scribe.Calendar .vcs
	!insertmacro CleanAssoc HKLM Memecode.Scribe.Contact .vcf
	!insertmacro CleanAssoc HKLM Memecode.Scribe.MailStore .mail3
	!insertmacro CleanAssoc HKLM Memecode.Scribe.Mailto mailto

	!insertmacro CleanProg HKCU Memecode.Scribe.Email
	!insertmacro CleanProg HKCU Memecode.Scribe.Folder
	!insertmacro CleanProg HKCU Memecode.Scribe.Calendar
	!insertmacro CleanProg HKCU Memecode.Scribe.Contact
	!insertmacro CleanProg HKCU Memecode.Scribe.MailStore
	!insertmacro CleanProg HKCU Memecode.Scribe.Mailto

	!insertmacro CleanProg HKLM Memecode.Scribe.Email
	!insertmacro CleanProg HKLM Memecode.Scribe.Folder
	!insertmacro CleanProg HKLM Memecode.Scribe.Calendar
	!insertmacro CleanProg HKLM Memecode.Scribe.Contact
	!insertmacro CleanProg HKLM Memecode.Scribe.MailStore
	!insertmacro CleanProg HKLM Memecode.Scribe.Mailto

	!insertmacro CleanMailDefault HKCU
	!insertmacro CleanMailDefault HKLM
	!insertmacro CleanClient HKCU
	!insertmacro CleanClient HKLM

	; Settings owns the mailto UserChoice hash, so it is left alone.
	DeleteRegValue HKCU "Software\RegisteredApplications" "Scribe"
	DeleteRegValue HKLM "Software\RegisteredApplications" "Scribe"

	DeleteRegKey HKCU "SOFTWARE\Memecode\Scribe"
	DeleteRegKey HKLM "${UNINSTKEY}"

	; Left over from the version based uninstall key used by older installs.
	!define OLDUNINSTKEY "Software\Microsoft\Windows\CurrentVersion\Uninstall\Scribe_v2.4"
	DeleteRegKey HKLM "${OLDUNINSTKEY}"

	SetAutoClose true

SectionEnd

Section /o "un.Remove Email and Settings"

	RMDir /r $APPDATA\Scribe

SectionEnd

; !system "del /Q .\scribe-setup"
; !system "rmdir .\scribe-setup"
!finalize "python ..\utils\Store\store.py ${OUTFILE} . ${__DATE__} ${__TIME__}"
